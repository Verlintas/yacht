---
import Base from '../layouts/Base.astro';
---

<Base
  title="Anvil Landing · IAC 垂直切片 · Verlintas 的小窝"
  description="IAC Forgeheart / Anvil Landing playable vertical slice: 16 km authored terrain, landed A-30, first-person walk, T2 terminal, three NPCs and a supply counter."
  panic={false}
>
  <div class="iac-root">
    <canvas id="iac-canvas" aria-label="Anvil Landing realtime scene"></canvas>
    <div class="iac-vignette" aria-hidden="true"></div>

    <div id="iac-hud">
      <header class="iac-place">
        <p class="iac-eyebrow">IAC FORGEHEART · 炉心星 / ANVIL CRUCIBLE</p>
        <h1>Anvil Landing</h1>
        <p class="iac-place-cn">砧炉着陆场</p>
        <p class="iac-sub">T2 ARRIVALS · PAD AP-03 · 16 KM AUTHORED TILE</p>
        <p class="iac-objective"><span class="iac-dot"></span>目标 · 抵达 T2 到港厅，拜访公会街补给</p>
      </header>

      <div class="iac-status">
        <span class="iac-status-dot"></span>
        <span data-mode-label>A-30 // LANDED</span>
        <span class="iac-status-sep">·</span>
        <span>LOCAL 05:42</span>
        <span class="iac-status-sep">·</span>
        <span>1.15 g</span>
      </div>

      <div id="iac-crosshair" class="iac-crosshair" aria-hidden="true"></div>

      <div id="iac-near" class="iac-near" aria-live="polite"></div>
      <div id="iac-prompt" class="iac-prompt">
        <span id="iac-prompt-key" class="iac-key">E</span>
        <span id="iac-prompt-text">交互</span>
      </div>
      <div id="iac-hint" class="iac-hint">F 下船 · E 交互 · 鼠标拖动环视</div>

      <div id="iac-parked" class="iac-parked is-active">
        <div class="iac-parked-line">
          <span class="iac-parked-kicker">A-30 雷霆 · T2 · 已降落</span>
          <span class="iac-parked-kicker">PAD AP-03 / TLOF 60 m</span>
        </div>
        <div class="iac-parked-action">
          <span class="iac-bigkey">F</span>
          <div>
            <strong>下船 / DISEMBARK</strong>
            <span>舷梯已放下 · 按 F 开始步行</span>
          </div>
        </div>
        <p class="iac-parked-note">鼠标拖动环视 · 滚轮缩放 · E 交互</p>
      </div>

      <div id="iac-foot" class="iac-foot">
        <div class="iac-foot-line"><span class="iac-dot"></span>ON FOOT · ANVIL LANDING</div>
        <p>WASD 移动 · Shift 冲刺 · Space 跳跃 · F 登船 · E 交互</p>
      </div>

      <div id="iac-stats" class="iac-stats"></div>
    </div>

    <div id="iac-dialog" class="iac-dialog" role="dialog" aria-modal="true" aria-labelledby="iac-dialog-name">
      <p class="iac-dialog-eyebrow">ANVIL LANDING · PERSONNEL</p>
      <h2 id="iac-dialog-name">凯拉·沃斯</h2>
      <p id="iac-dialog-role" class="iac-dialog-role">码头长 / DOCKMASTER</p>
      <p id="iac-dialog-text" class="iac-dialog-text"></p>
      <p id="iac-dialog-foot" class="iac-dialog-foot">E 继续 · ESC 关闭</p>
    </div>

    <div id="iac-shop" class="iac-shop" role="dialog" aria-modal="true" aria-labelledby="iac-shop-title">
      <div class="iac-shop-head">
        <div>
          <p class="iac-dialog-eyebrow">GUILD ROW OUTFITTER</p>
          <h2 id="iac-shop-title">公会街补给</h2>
        </div>
        <span id="iac-shop-credits" class="iac-shop-credits">1,250 CR</span>
      </div>
      <p class="iac-shop-sub">TRADER · 索恩·哈珀 · DEMO INVENTORY</p>
      <div id="iac-shop-items" class="iac-shop-items"></div>
      <button id="iac-shop-close" class="iac-shop-close" type="button">ESC 关闭 / CLOSE</button>
    </div>

    <div id="iac-toast" class="iac-toast" role="status" aria-live="polite"></div>

    <div id="iac-fade" class="iac-fade" aria-hidden="true"></div>

    <div id="iac-loading" class="iac-loading">
      <div class="iac-loading-inner">
        <p class="iac-eyebrow">IAC FORGEHEART · ANVIL CRUCIBLE</p>
        <h2>Anvil Landing</h2>
        <p class="iac-loading-sub">砧炉着陆场 · vertical slice</p>
        <div class="iac-loading-track"><i></i></div>
        <p id="iac-loading-label" class="iac-loading-label">BOOTING SURFACE FRAME</p>
      </div>
    </div>
  </div>

  <style is:global>
    body:has(.iac-root) {
      overflow: hidden;
      background: #04070a;
    }

    body:has(.iac-root) > .nav,
    body:has(.iac-root) footer.foot,
    body:has(.iac-root) .skip-link {
      display: none !important;
    }

    body:has(.iac-root) > .shell {
      padding: 0;
      max-width: none;
    }

    body:has(.iac-root) > .shell > main {
      padding: 0;
    }

    .iac-root {
      --iac-amber: #d8b073;
      --iac-amber-soft: rgba(216, 176, 115, 0.18);
      --iac-teal: #8ac9c7;
      --iac-text: #e9eef0;
      --iac-dim: #9dafb5;
      --iac-faint: #6d8088;
      --iac-panel: rgba(5, 12, 15, 0.76);
      --iac-line: rgba(255, 255, 255, 0.14);
      position: fixed;
      inset: 0;
      z-index: 50;
      overflow: hidden;
      background: #04070a;
      color: var(--iac-text);
      color-scheme: dark;
      font-family: var(--sans, system-ui, sans-serif);
      isolation: isolate;
    }

    #iac-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      outline: none;
      touch-action: none;
      cursor: crosshair;
    }

    .iac-vignette {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background:
        radial-gradient(120% 100% at 50% 45%, transparent 44%, rgba(0, 0, 0, 0.34) 100%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.22) 0%, transparent 16%, transparent 78%, rgba(0, 0, 0, 0.3) 100%);
    }

    #iac-hud {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
    }

    .iac-eyebrow,
    .iac-sub,
    .iac-status,
    .iac-hint,
    .iac-near,
    .iac-prompt,
    .iac-parked-kicker,
    .iac-parked-note,
    .iac-dialog-eyebrow,
    .iac-dialog-role,
    .iac-dialog-foot,
    .iac-shop-sub,
    .iac-shop-item-price,
    .iac-shop-close,
    .iac-loading-label,
    .iac-foot p,
    .iac-stats {
      font-family: var(--mono, ui-monospace, monospace);
    }

    /* ── place header ───────────────────────── */
    .iac-place {
      position: absolute;
      top: clamp(18px, 3.2vh, 34px);
      left: clamp(20px, 3.4vw, 52px);
      width: min(420px, 76vw);
      padding: 14px 16px 13px 18px;
      border-left: 2px solid var(--iac-amber);
      background: linear-gradient(90deg, rgba(3, 8, 10, 0.92), rgba(3, 8, 10, 0.5) 82%, transparent);
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(10px);
    }

    .iac-eyebrow {
      margin: 0 0 7px;
      color: var(--iac-amber);
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .iac-place h1 {
      margin: 0;
      font-family: var(--serif, Georgia, serif);
      font-size: clamp(28px, 3.2vw, 42px);
      font-weight: 500;
      line-height: 0.98;
      letter-spacing: -0.015em;
      color: #f3f1e9;
    }

    .iac-place-cn {
      margin: 4px 0 0;
      font-family: var(--serif, Georgia, serif);
      font-size: 15px;
      letter-spacing: 0.16em;
      color: var(--iac-amber);
    }

    .iac-sub {
      margin: 9px 0 0;
      color: #93a5aa;
      font-size: 9px;
      letter-spacing: 0.14em;
    }

    .iac-objective {
      display: flex;
      align-items: center;
      gap: 7px;
      margin: 10px 0 0;
      padding-top: 9px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      color: #c9d4d7;
      font-size: 11px;
      letter-spacing: 0.04em;
    }

    .iac-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--iac-teal);
      box-shadow: 0 0 9px rgba(138, 201, 199, 0.8);
      flex: none;
    }

    /* ── status ─────────────────────────────── */
    .iac-status {
      position: absolute;
      top: clamp(20px, 3.4vh, 36px);
      right: clamp(20px, 3.4vw, 52px);
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 6px 9px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(3, 8, 10, 0.56);
      color: #c2cfd3;
      font-size: 8.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      backdrop-filter: blur(9px);
    }

    .iac-status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #82d4a6;
      box-shadow: 0 0 8px rgba(130, 212, 166, 0.85);
    }

    .iac-status-sep {
      color: #4d5f66;
    }

    /* ── crosshair + prompt ─────────────────── */
    .iac-crosshair {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 22px;
      height: 22px;
      transform: translate(-50%, -50%);
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .iac-crosshair.is-active {
      opacity: 0.9;
    }

    .iac-crosshair::before,
    .iac-crosshair::after {
      content: '';
      position: absolute;
      background: rgba(255, 240, 214, 0.85);
      box-shadow: 0 0 5px rgba(0, 0, 0, 0.7);
    }

    .iac-crosshair::before {
      left: 10px;
      top: 2px;
      width: 1px;
      height: 18px;
    }

    .iac-crosshair::after {
      top: 10px;
      left: 2px;
      height: 1px;
      width: 18px;
    }

    .iac-near {
      position: absolute;
      left: 50%;
      bottom: 126px;
      transform: translateX(-50%);
      max-width: min(560px, 82vw);
      padding: 6px 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(4, 10, 12, 0.72);
      color: #e7dfcd;
      font-size: 10px;
      letter-spacing: 0.08em;
      text-align: center;
      opacity: 0;
      transition: opacity 0.18s ease;
      backdrop-filter: blur(10px);
    }

    .iac-near.is-active {
      opacity: 1;
    }

    .iac-prompt {
      position: absolute;
      left: 50%;
      bottom: 76px;
      display: flex;
      align-items: center;
      gap: 10px;
      transform: translateX(-50%) translateY(8px);
      padding: 8px 14px 8px 9px;
      border: 1px solid rgba(216, 176, 115, 0.46);
      background: linear-gradient(180deg, rgba(12, 20, 22, 0.9), rgba(5, 10, 12, 0.86));
      color: #f4ead8;
      font-size: 12px;
      letter-spacing: 0.05em;
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.32);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.16s ease, transform 0.16s ease;
      backdrop-filter: blur(12px);
    }

    .iac-prompt.is-active {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .iac-key,
    .iac-bigkey {
      display: grid;
      place-items: center;
      border: 1px solid rgba(216, 176, 115, 0.68);
      background: rgba(216, 176, 115, 0.12);
      color: #f6dfb6;
      font-family: var(--mono, ui-monospace, monospace);
      font-weight: 600;
      line-height: 1;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
    }

    .iac-key {
      width: 27px;
      height: 27px;
      font-size: 12px;
    }

    .iac-bigkey {
      width: 50px;
      height: 50px;
      font-size: 23px;
      flex: none;
    }

    .iac-hint {
      position: absolute;
      left: clamp(20px, 3.4vw, 52px);
      bottom: clamp(20px, 3.2vh, 34px);
      max-width: 64vw;
      color: #a8b8bd;
      font-size: 9px;
      line-height: 1.55;
      letter-spacing: 0.08em;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.9);
    }

    /* ── parked prompt ──────────────────────── */
    .iac-parked {
      position: absolute;
      left: 50%;
      bottom: 68px;
      width: min(520px, calc(100vw - 40px));
      transform: translateX(-50%) translateY(10px);
      padding: 12px 16px 11px;
      border: 1px solid rgba(216, 176, 115, 0.4);
      border-left: 2px solid var(--iac-amber);
      background: linear-gradient(180deg, rgba(8, 15, 17, 0.92), rgba(4, 9, 11, 0.84));
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.38);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.24s ease, transform 0.24s ease;
      backdrop-filter: blur(14px) saturate(1.1);
    }

    .iac-parked.is-active {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .iac-parked-line {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 9px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--iac-faint);
      font-size: 8px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .iac-parked-action {
      display: flex;
      align-items: center;
      gap: 13px;
      padding-top: 11px;
    }

    .iac-parked-action strong {
      display: block;
      color: #f6ecd9;
      font-family: var(--serif, Georgia, serif);
      font-size: 19px;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .iac-parked-action span:not(.iac-bigkey) {
      display: block;
      margin-top: 3px;
      color: #a9b7bb;
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 9px;
      letter-spacing: 0.08em;
    }

    .iac-parked-note {
      margin: 9px 0 0;
      color: #75888e;
      font-size: 8px;
      letter-spacing: 0.1em;
    }

    /* ── foot chip ──────────────────────────── */
    .iac-foot {
      position: absolute;
      right: clamp(20px, 3.4vw, 52px);
      bottom: clamp(20px, 3.2vh, 34px);
      display: none;
      text-align: right;
      color: #91a5ab;
      font-size: 8.5px;
      letter-spacing: 0.08em;
    }

    .iac-foot.is-active,
    #iac-hud.is-foot .iac-foot {
      display: block;
    }

    .iac-foot-line {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 7px;
      color: #cbd5d7;
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 9px;
      letter-spacing: 0.12em;
    }

    .iac-foot p {
      margin: 6px 0 0;
      color: #7e9197;
      font-size: 8px;
      line-height: 1.5;
    }

    /* ── dialog / shop ──────────────────────── */
    .iac-dialog,
    .iac-shop {
      position: fixed;
      z-index: 20;
      pointer-events: auto;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background:
        linear-gradient(180deg, rgba(11, 19, 21, 0.94), rgba(4, 9, 11, 0.9)),
        radial-gradient(80% 80% at 0% 0%, rgba(216, 176, 115, 0.08), transparent 60%);
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(16px) saturate(1.15);
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }

    .iac-dialog.is-open,
    .iac-shop.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .iac-dialog {
      left: 50%;
      bottom: 92px;
      width: min(640px, calc(100vw - 48px));
      padding: 17px 21px 15px;
      transform: translateX(-50%) translateY(12px);
      border-left: 2px solid var(--iac-amber);
    }

    .iac-dialog.is-open {
      transform: translateX(-50%) translateY(0);
    }

    .iac-dialog-eyebrow {
      margin: 0 0 6px;
      color: var(--iac-amber);
      font-size: 8px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .iac-dialog h2,
    .iac-shop h2 {
      margin: 0;
      color: #f4f0e6;
      font-family: var(--serif, Georgia, serif);
      font-size: 25px;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .iac-dialog-role {
      margin: 3px 0 12px;
      color: #8fa5aa;
      font-size: 8.5px;
      letter-spacing: 0.16em;
    }

    .iac-dialog-text {
      min-height: 48px;
      margin: 0;
      color: #e2e4dd;
      font-size: 15px;
      line-height: 1.7;
      letter-spacing: 0.02em;
    }

    .iac-dialog-foot {
      margin: 14px 0 0;
      padding-top: 10px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      color: #a98f63;
      font-size: 9px;
      letter-spacing: 0.12em;
    }

    .iac-shop {
      right: clamp(20px, 3.4vw, 52px);
      top: 96px;
      width: min(390px, calc(100vw - 40px));
      padding: 17px 17px 14px;
      border-left: 2px solid var(--iac-teal);
    }

    .iac-shop-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .iac-shop-credits {
      flex: none;
      margin-top: 4px;
      padding: 4px 8px;
      border: 1px solid rgba(138, 201, 199, 0.36);
      color: var(--iac-teal);
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 10px;
      letter-spacing: 0.08em;
    }

    .iac-shop-sub {
      margin: 6px 0 12px;
      color: #7c9197;
      font-size: 8px;
      letter-spacing: 0.12em;
    }

    .iac-shop-items {
      display: grid;
      gap: 9px;
    }

    .iac-shop-item {
      padding: 9px 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.025);
    }

    .iac-shop-item-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .iac-shop-item-name {
      color: #eee9dc;
      font-size: 12.5px;
      letter-spacing: 0.02em;
    }

    .iac-shop-item-price {
      flex: none;
      color: var(--iac-amber);
      font-size: 9px;
      letter-spacing: 0.08em;
    }

    .iac-shop-item-desc {
      margin: 4px 0 8px;
      color: #91a4a9;
      font-size: 10.5px;
      line-height: 1.45;
    }

    .iac-shop-buy {
      appearance: none;
      width: 100%;
      padding: 6px 8px;
      border: 1px solid rgba(216, 176, 115, 0.44);
      background: rgba(216, 176, 115, 0.12);
      color: #f0d9b0;
      font: 9px/1.2 var(--mono, ui-monospace, monospace);
      letter-spacing: 0.14em;
      cursor: pointer;
      transition: background 0.16s ease, border-color 0.16s ease;
    }

    .iac-shop-buy:hover:not(:disabled) {
      background: rgba(216, 176, 115, 0.22);
      border-color: rgba(216, 176, 115, 0.7);
    }

    .iac-shop-buy:disabled {
      opacity: 0.45;
      cursor: default;
    }

    .iac-shop-close {
      appearance: none;
      width: 100%;
      margin-top: 12px;
      padding: 8px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.03);
      color: #9fb1b6;
      font-size: 8.5px;
      letter-spacing: 0.14em;
      cursor: pointer;
    }

    .iac-shop-close:hover {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.32);
    }

    /* ── toast / stats / fade / loading ─────── */
    .iac-toast {
      position: fixed;
      left: 50%;
      top: 86px;
      z-index: 30;
      transform: translateX(-50%) translateY(-6px);
      padding: 7px 13px;
      border: 1px solid rgba(138, 201, 199, 0.32);
      background: rgba(5, 12, 14, 0.9);
      color: #d8e5e5;
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 9.5px;
      letter-spacing: 0.1em;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
      backdrop-filter: blur(10px);
    }

    .iac-toast.is-active {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .iac-stats {
      position: absolute;
      right: clamp(20px, 3.4vw, 52px);
      top: 62px;
      padding: 6px 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(3, 8, 10, 0.7);
      color: #c4d1d4;
      font-size: 8px;
      letter-spacing: 0.06em;
      text-align: right;
      opacity: 0;
      transition: opacity 0.2s ease;
      white-space: nowrap;
    }

    .iac-stats.is-active {
      opacity: 1;
    }

    .iac-fade {
      position: absolute;
      inset: 0;
      z-index: 40;
      background: #020406;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .iac-fade.is-black {
      opacity: 1;
    }

    .iac-loading {
      position: absolute;
      inset: 0;
      z-index: 60;
      display: grid;
      place-items: center;
      background:
        radial-gradient(60% 50% at 50% 38%, #0a1215 0%, #04070a 72%);
      transition: opacity 0.7s ease, visibility 0.7s;
