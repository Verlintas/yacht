---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="Anvil Landing · Kitbash3D Hero Port · Verlintas 的小窝"
  description="Anvil Landing Kitbash3D Sci-Fi Industrial hero port: 1.19M-triangle real-time preview and Blender reference renders."
  panic={false}
>
  <div class="kitbash-shell">
    <iframe
      src={`${base}/kitbash-port/preview/`}
      title="Anvil Landing Kitbash3D real-time preview"
      loading="eager"
      allow="fullscreen"
    ></iframe>
  </div>

  <style is:global>
    .kitbash-shell {
      position: relative;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      height: calc(100vh - 64px);
      min-height: 640px;
      overflow: hidden;
      background: #05090c;
      border-top: 1px solid var(--border);
    }

    .kitbash-shell iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  </style>
</Base>
