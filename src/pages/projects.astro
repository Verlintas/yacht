---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import ProjectMetrics from '../components/ProjectMetrics.astro';
import ProjectVolume from '../components/ProjectVolume.astro';
import metricsData from '../data/project-metrics.json';
import { scoreProject, type ProjectMetrics as Metrics } from '../lib/project-score';

const projects = await getCollection('projects');

const statusMeta: Record<string, { label: string; tone: string }> = {
  active: { label: '进行中', tone: 'badge-good' },
  paused: { label: '暂停', tone: 'badge-warn' },
  idea: { label: '想法', tone: 'badge' },
  done: { label: '已完成', tone: 'badge' },
  archived: { label: '归档', tone: 'badge' },
};

const order = ['active', 'paused', 'idea', 'done', 'archived'];

const groups = [
  { key: 'personal', label: '个人', note: '自己名下的仓库', link: null },
  { key: 'nusv', label: 'NUSV', note: 'United Science Vaca 组织', link: 'https://github.com/NUSV' },
] as const;

/** repo 全名 → 采集到的指标 */
const metricsByRepo = (metricsData.projects ?? {}) as Record<string, Metrics>;

const repoOf = (repo?: string): string =>
  (repo ?? '').replace(/^https:\/\/github\.com\//, '').replace(/\/+$/, '');

const items = await Promise.all(
  projects.map(async (entry) => {
    const metrics = metricsByRepo[repoOf(entry.data.repo)];
    return {
      entry,
      Content: (await render(entry)).Content,
      metrics,
      score: metrics ? scoreProject(metrics) : null,
    };
  }),
);

type Item = (typeof items)[number];

const byRecency = (a: Item, b: Item): number => {
  const byStatus = order.indexOf(a.entry.data.status) - order.indexOf(b.entry.data.status);
  if (byStatus !== 0) return byStatus;
  return b.entry.data.updated.valueOf() - a.entry.data.updated.valueOf();
};

const byScore = (a: Item, b: Item): number =>
  (b.score?.total ?? 0) - (a.score?.total ?? 0) || byRecency(a, b);

const flagships = items.filter((item) => item.entry.data.flagship).sort(byScore);

const byGroup = groups.map((group) => ({
  group,
  items: items
    .filter((item) => item.entry.data.owner === group.key && !item.entry.data.flagship)
    .sort(byRecency),
}));

const formatDate = (date: Date): string =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;

const measured = items.filter((item) => (item.metrics?.loc ?? 0) > 0);
const latestMetrics = Object.values(metricsByRepo)
  .map((metric) => metric.measuredAt)
  .filter((value): value is string => typeof value === 'string')
  .sort()
  .at(-1);
const metricsLabel = latestMetrics ? latestMetrics.slice(0, 7) : '—';

const totals = {
  loc: measured.reduce((sum, item) => sum + (item.metrics?.loc ?? 0), 0),
  chars: measured.reduce((sum, item) => sum + (item.metrics?.chars ?? 0), 0),
  commits: Object.values(metricsByRepo).reduce((sum, metric) => sum + (metric.commits ?? 0), 0),
  tests: Object.values(metricsByRepo).reduce((sum, metric) => sum + (metric.tests ?? 0), 0),
  versions: Object.values(metricsByRepo).reduce((sum, metric) => sum + (metric.versions ?? 0), 0),
};
---

<Base title="船坞 · Verlintas 的小窝">
  <p class="eyebrow">项目清单 · {items.length} 项 · 旗舰 {flagships.length} 条</p>
  <h1 class="page-title">船坞</h1>
  <p class="page-sub">
    手上做过的东西都放在这里，想到就加，没有固定方向。在 <code>src/content/projects/</code> 下新建 Markdown 文件即可添加。
  </p>

  <div class="panel panel-pad spaced">
    <div class="card-head">
      <span class="readout-label">工程总览</span>
      <span class="readout-note">{measured.length} 项有指标 · 采集于 {metricsLabel}</span>
    </div>
    <div class="stat-grid">
      <div class="stat-cell">
        <span class="readout-label">代码行</span>
        <strong class="stat-value">{totals.loc.toLocaleString('zh-CN')}</strong>
      </div>
      <div class="stat-cell">
        <span class="readout-label">字符</span>
        <strong class="stat-value">{totals.chars.toLocaleString('zh-CN')}</strong>
      </div>
      <div class="stat-cell">
        <span class="readout-label">提交</span>
        <strong class="stat-value">{totals.commits.toLocaleString('zh-CN')}</strong>
      </div>
      <div class="stat-cell">
        <span class="readout-label">测试用例</span>
        <strong class="stat-value">{totals.tests.toLocaleString('zh-CN')}</strong>
      </div>
      <div class="stat-cell">
        <span class="readout-label">发布版本</span>
        <strong class="stat-value">{totals.versions.toLocaleString('zh-CN')}</strong>
      </div>
    </div>
    <p class="readout-note spaced">
      旗舰按六项打分选出：规模与架构、测试、CI 与发布纪律、文档、持续投入、成熟度。
      <b>星数不进评分</b>——它衡量的是传播，不是工程质量。
      规模按 30 万行、测试按 4000 用例作为满分参考点（对数刻度），所以大项目之间也能拉开差距。
    </p>
  </div>

  {
    flagships.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2 class="section-title">
            <svg
              class="flagship-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 21V4M5 5h11l-1.6 3.2L16 11.4H5" />
            </svg>
            旗舰
          </h2>
          <span class="section-note">船坞里最拿得出手的几条船</span>
        </div>
        <div class="grid grid-wide">
          {flagships.map(({ entry, Content, metrics, score }) => (
            <article class="panel panel-pad project-card project-flagship">
              <div class="card-head">
                <span class="readout-label">{formatDate(entry.data.updated)} 更新</span>
                <span class="badge-row">
                  <span class="badge badge-flagship">旗舰</span>
                  {score && <span class="badge">评分 {score.total.toFixed(1)}</span>}
                  <span class={`badge ${statusMeta[entry.data.status].tone}`}>
                    {statusMeta[entry.data.status].label}
                  </span>
                </span>
              </div>
              <strong class="note-title">{entry.data.title}</strong>
              {entry.data.summary && <span class="readout-note">{entry.data.summary}</span>}
                <ProjectMetrics metrics={metrics} />

              <div class="project-foot">
                <span class="tag-row">
                  {entry.data.stack.map((item) => (
                    <span class="tag tag-sm">{item}</span>
                  ))}
                </span>
                {entry.data.repo && (
                  <a class="repo-link" href={entry.data.repo} target="_blank" rel="noreferrer noopener">
                    仓库
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                      <path d="M8 16 16 8M10 8h6v6" />
                    </svg>
                  </a>
                )}
              </div>

              <details class="project-more">
                <summary>详细</summary>
                <div class="prose prose-sm">
                  <Content />
                </div>
              </details>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    byGroup.map(
      ({ group, items: groupItems }) =>
        groupItems.length > 0 && (
          <section class="section">
            <div class="section-head">
              <h2 class="section-title">{group.label}</h2>
              <span class="section-note">
                {group.note} · {groupItems.length} 项
              </span>
              {group.link && (
                <a class="section-note" href={group.link} target="_blank" rel="noreferrer noopener">
                  组织主页 →
                </a>
              )}
            </div>
            <div class="grid grid-wide">
              {groupItems.map(({ entry, Content, metrics, score }) => (
                <article class="panel panel-pad project-card">
                  <div class="card-head">
                    <span class="readout-label">{formatDate(entry.data.updated)} 更新</span>
                    {score && <span class="badge">{score.total.toFixed(1)}</span>}
                    <span class={`badge ${statusMeta[entry.data.status].tone}`}>
                      {statusMeta[entry.data.status].label}
                    </span>
                  </div>
                  <strong class="note-title">{entry.data.title}</strong>
                  {entry.data.summary && <span class="readout-note">{entry.data.summary}</span>}
                <ProjectMetrics metrics={metrics} />

                  <div class="project-foot">
                    <span class="tag-row">
                      {entry.data.stack.map((item) => (
                        <span class="tag tag-sm">{item}</span>
                      ))}
                    </span>
                    {entry.data.repo && (
                      <a class="repo-link" href={entry.data.repo} target="_blank" rel="noreferrer noopener">
                        仓库
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                          <path d="M8 16 16 8M10 8h6v6" />
                        </svg>
                      </a>
                    )}
                  </div>

                  <details class="project-more">
                    <summary>详细</summary>
                    <div class="prose prose-sm">
                      <Content />
                    </div>
                  </details>
                </article>
              ))}
            </div>
          </section>
        ),
    )
  }
  <ProjectVolume
    items={items.map((item) => ({ title: item.entry.data.title, metrics: item.metrics }))}
  />
</Base>
