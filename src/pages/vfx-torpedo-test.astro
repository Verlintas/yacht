<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>鱼雷 / 爆炸 VFX · 测试场</title>
    <style>
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #02040a;
        color: #d9e7f2;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      #vfx-canvas {
        display: block;
        width: 100vw;
        height: 100vh;
        outline: none;
      }
      #vfx-hud {
        position: fixed;
        left: 18px;
        bottom: 18px;
        z-index: 2;
        padding: 10px 13px;
        border: 1px solid rgba(150, 200, 230, 0.18);
        border-radius: 4px;
        background: rgba(3, 8, 14, 0.72);
        font-size: 10px;
        line-height: 1.7;
        letter-spacing: 0.02em;
        color: #8fb6cc;
        pointer-events: none;
        font-variant-numeric: tabular-nums;
        backdrop-filter: blur(8px);
      }
      #vfx-hud strong {
        color: #e6f3fb;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <canvas id="vfx-canvas"></canvas>
    <div id="vfx-hud">loading</div>
    <script type="module">
      import '../scripts/vfx-torpedo-demo';
    </script>
  </body>
</html>
