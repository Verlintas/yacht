    padding: 4px 5px 4px 3px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: transparent;
    color: #93a9b4;
    text-align: left;
    font: inherit;
    font-size: 10px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }

  .weapon-row:last-child { border-bottom: 0; }

  .weapon-row:hover {
    background: rgba(89, 224, 200, 0.06);
    color: #d8f5f0;
  }

  .weapon-row.is-on {
    color: #eafffb;
    background: rgba(89, 224, 200, 0.09);
    box-shadow: inset 2px 0 0 rgba(89, 224, 200, 0.9);
  }

  .weapon-key {
    display: grid;
    place-items: center;
    width: 18px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 8px;
    color: #c9a55c;
  }

  .weapon-row.is-on .weapon-key {
    border-color: rgba(89, 224, 200, 0.6);
    color: #59e0c8;
  }

  .weapon-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .weapon-count {
    font-size: 8px;
    color: rgba(150, 180, 190, 0.6);
  }

  .weapon-bar {
    grid-column: 1 / 4;
    display: block;
    height: 2px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .weapon-bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(89, 224, 200, 0.55), #59e0c8);
    transition: width 0.08s linear;
  }

  .weapon-row.is-auto {
    color: rgba(150, 180, 190, 0.48);
    cursor: default;
  }

  .weapon-row.is-auto .weapon-bar { display: none; }

  .weapon-row.is-auto .weapon-key {
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(150, 180, 190, 0.45);
  }

  /* ── 航向/威胁带 ─────────────────────── */
  #bearing-strip {
    position: absolute;
    top: 32px;
    left: 50%;
    transform: translateX(-50%);
    width: min(460px, 46vw);
    height: 30px;
    z-index: 3;
    border-bottom: 1px solid rgba(89, 224, 200, 0.24);
    font-family: var(--mono);
    color: #59e0c8;
    pointer-events: none;
  }

  .bearing-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    height: 14px;
    background: repeating-linear-gradient(90deg, rgba(89, 224, 200, 0.38) 0 1px, transparent 1px 30px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    opacity: 0.7;
  }

  .bearing-center {
    position: absolute;
    left: 50%;
    top: 3px;
    width: 1px;
    height: 24px;
    background: #9ff0dc;
    box-shadow: 0 0 8px rgba(89, 224, 200, 0.8);
  }

  .bearing-heading {
    position: absolute;
    left: 50%;
    top: 1px;
    transform: translateX(-50%);
    font-size: 7px;
    letter-spacing: 0.12em;
    color: rgba(159, 240, 220, 0.75);
    background: rgba(4, 12, 15, 0.7);
    padding: 0 4px;
  }

  .bearing-arrow {
    position: absolute;
    top: 2px;
    transform: translateX(-50%);
    font-size: 10px;
    line-height: 1;
    transition: left 0.16s linear, opacity 0.2s;
    text-shadow: 0 0 8px currentColor;
  }

  .bearing-target { color: #59e0c8; }
  .bearing-enemy { color: #ff5a42; }

  /* ── BOSS 血条 ───────────────────────── */
  #boss-bar {
    position: absolute;
    top: 238px;
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, 56vw);
    padding: 8px 14px 9px;
    border: 1px solid rgba(255, 70, 52, 0.48);
    background:
      linear-gradient(180deg, rgba(42, 6, 4, 0.78), rgba(12, 3, 3, 0.62)),
      repeating-linear-gradient(0deg, rgba(255, 90, 70, 0.04) 0 1px, transparent 1px 3px);
    box-shadow: 0 0 26px rgba(255, 46, 30, 0.12), inset 0 0 24px rgba(255, 60, 40, 0.05);
    font-family: var(--mono);
    color: #ffb2a2;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
  }

  #boss-bar.is-on { opacity: 1; visibility: visible; }

  .boss-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 5px;
  }

  #boss-name {
    font-family: var(--serif);
    font-size: 16px;
    color: #ffe6df;
    letter-spacing: 0.04em;
    text-shadow: 0 0 12px rgba(255, 80, 60, 0.4);
  }

  #boss-level {
    font-size: 8px;
    letter-spacing: 0.22em;
    color: #ff7a64;
  }

  .boss-track {
    position: relative;
    height: 9px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 90, 70, 0.2);
    overflow: hidden;
  }

  .boss-track i {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    transition: width 0.22s ease;
  }

  #boss-hull-fill {
    background: linear-gradient(90deg, #7d120c, #ff4a32 60%, #ff9a7a);
    box-shadow: 0 0 14px rgba(255, 60, 40, 0.6);
  }

  #boss-shield-fill {
    background: linear-gradient(90deg, rgba(60, 150, 180, 0.4), rgba(159, 232, 255, 0.75));
    box-shadow: 0 0 10px rgba(120, 220, 255, 0.35);
    opacity: 0.75;
  }

  .boss-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: rgba(255, 150, 130, 0.65);
  }

  /* ── 受击提示 / 爆炸闪光 ─────────────── */
  #hit-alert {
    position: absolute;
    left: 50%;
    top: 54%;
    z-index: 5;
    transform: translate(-50%, -50%);
    padding: 5px 16px;
    border: 1px solid rgba(255, 70, 52, 0.75);
    background: rgba(40, 4, 2, 0.7);
    color: #ff9a82;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    opacity: 0;
    pointer-events: none;
  }

  #hit-alert.is-on { animation: hitAlert 0.75s ease-out; }

  @keyframes hitAlert {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }
    15% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    75% { opacity: 1; }
    100% { opacity: 0; }
  }

  #impact-flash {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(65% 55% at 50% 50%, rgba(255, 250, 235, 0.75), rgba(255, 140, 60, 0.22) 42%, transparent 72%);
    mix-blend-mode: screen;
    transition: opacity 0.4s ease-out;
  }

  /* ── 更大、更长的结构/护盾条 ─────────── */
  .hud-vitals {
    min-width: 300px;
    bottom: 138px;
    gap: 8px;
    color: #8fe8d8;
  }

  .vital {
    grid-template-columns: 38px 1fr 112px;
    gap: 9px;
    font-size: 9.5px;
    color: rgba(143, 232, 216, 0.7);
  }

  .vital-bar {
    position: relative;
    height: 8px;
    border: 1px solid rgba(89, 224, 200, 0.16);
    background: rgba(0, 0, 0, 0.42);
    overflow: hidden;
  }

  .vital-bar i {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
  }

  .vital-ghost {
    z-index: 0;
    background: rgba(255, 80, 58, 0.55);
    transition: width 0.85s ease 0.12s;
  }

  .vital-bar i:not(.vital-ghost) {
    z-index: 1;
    background: linear-gradient(90deg, #2f9d8d, #59e0c8);
    box-shadow: 0 0 9px rgba(89, 224, 200, 0.35);
    transition: width 0.18s ease;
  }

  .vital-shield i:not(.vital-ghost) {
    background: linear-gradient(90deg, #2f7f9a, #9fe8ff);
    box-shadow: 0 0 9px rgba(120, 220, 255, 0.3);
  }

  .vital.is-critical .vital-bar i:not(.vital-ghost) {
    background: linear-gradient(90deg, #8f1a12, #ff5a42);
    animation: vitalPulse 0.7s ease-in-out infinite;
  }

  .vital.is-critical b { color: #ff8a72; }

  @keyframes vitalPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }

  /* 武器面板移到右上 */
  #weapon-panel {
    top: 96px;
    bottom: auto;
  }

  @media (max-width: 760px) {
    #weapon-panel, #bearing-strip, #boss-bar { display: none; }
  }

  /* ── 跃迁充能环 ─────────────────────── */
  #boost-ui {
    position: absolute;
    left: 50%;
    bottom: 132px;
    transform: translateX(-50%);
    width: 118px;
    height: 118px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.22s;
  }

  #boost-ui.is-on { opacity: 1; }

  #boost-ui svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .boost-outer {
    fill: none;
    stroke: rgba(120, 220, 220, 0.12);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .boost-ticks {
    fill: none;
    stroke: rgba(140, 230, 225, 0.28);
    stroke-width: 3;
    stroke-dasharray: 1 9;
    transform-origin: 60px 60px;
  }

  .boost-track {
    fill: none;
    stroke: rgba(255, 255, 255, 0.09);
    stroke-width: 3;
  }

  .boost-fill {
    fill: none;
    stroke: #59e0c8;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 289.03;
    stroke-dashoffset: 289.03;
    transform: rotate(-90deg);
    transform-origin: 60px 60px;
    transition: stroke-dashoffset 0.08s linear, stroke 0.2s;
    filter: drop-shadow(0 0 5px rgba(89, 224, 200, 0.55));
  }

  #boost-ui.is-charging .boost-ticks {
    animation: warpTicks 5.5s linear infinite;
    stroke: rgba(140, 240, 230, 0.5);
  }

  #boost-ui.is-ready .boost-fill {
    stroke: #ffd98a;
    filter: drop-shadow(0 0 12px rgba(255, 217, 138, 0.95));
    animation: boostPulse 0.7s ease-in-out infinite;
  }

  #boost-ui.is-ready .boost-ticks {
    stroke: rgba(255, 217, 138, 0.75);
    animation: warpTicks 2.2s linear infinite;
  }

  #boost-ui.is-shift .boost-fill {
    stroke: #7fd4ff;
    filter: drop-shadow(0 0 6px rgba(127, 212, 255, 0.65));
  }

  #boost-ui.is-warping .boost-outer {
    stroke: rgba(255, 240, 200, 0.6);
    animation: warpPulse 0.35s ease-in-out infinite;
  }

  @keyframes warpTicks {
    to { transform: rotate(360deg); }
  }

  @keyframes warpPulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.9; }
  }

  @keyframes boostPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  .boost-text {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 1px;
    text-align: center;
    font-family: var(--mono);
    letter-spacing: 0.12em;
    color: var(--text-faint);
    pointer-events: none;
  }

  .boost-text small {
    font-size: 7px;
    letter-spacing: 0.14em;
    color: rgba(160, 220, 215, 0.7);
  }

  .boost-text b {
    font-size: 16px;
    font-weight: 400;
    color: var(--text);
    letter-spacing: 0.08em;
  }

  .boost-text span {
    font-size: 7px;
    color: rgba(150, 180, 190, 0.6);
  }

  #boost-ui.is-ready .boost-text b { color: #ffd98a; }
  #boost-ui.is-ready .boost-text small { color: #ffd98a; }
  #boost-ui.is-shift .boost-text b { color: #7fd4ff; }
  #boost-ui.is-shift .boost-text { font-size: 8px; letter-spacing: 0.06em; }

  #warp-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(89, 224, 200, 0.1) 100%),
      linear-gradient(180deg, rgba(89, 224, 200, 0.05), transparent 18%, transparent 82%, rgba(89, 224, 200, 0.05));
    transition: opacity 0.35s;
  }

  #hud.is-warp-ready #warp-overlay { opacity: 0.6; }
  #hud.is-warping #warp-overlay {
    opacity: 1;
    background:
      radial-gradient(100% 80% at 50% 50%, transparent 45%, rgba(255, 217, 138, 0.14) 100%),
      linear-gradient(180deg, rgba(255, 240, 200, 0.07), transparent 20%, transparent 80%, rgba(255, 240, 200, 0.07));
  }

  /* ── 帮助 ───────────────────────────── */
  #help-hint {
    position: absolute;
    left: 26px;
    bottom: 104px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    pointer-events: none;
  }

  #help-hint kbd, .help-note kbd {
    padding: 1px 5px;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 9px;
  }

  #help-panel {
    position: absolute;
    inset: 0;
    z-index: 36;
    display: grid;
    place-items: center;
    background: rgba(2, 5, 9, 0.82);
    backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s, visibility 0.22s;
  }

  #help-panel.is-open { opacity: 1; visibility: visible; }

  .help-inner {
    width: min(760px, 90vw);
    border: 1px solid var(--border-strong);
    background: rgba(6, 12, 18, 0.96);
    padding: 22px 26px 20px;
  }

  .help-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .help-head h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 500;
  }

  .help-head button {
    width: 28px; height: 28px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 16px;
  }

  .help-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 30px; }

  .help-grid h3 {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .help-grid dl {
    margin: 0;
    display: grid;
    grid-template-columns: 108px 1fr;
    gap: 6px 12px;
    font-size: 12.5px;
  }

  .help-grid dt {
    font-family: var(--mono);
    color: var(--brass);
    font-size: 11px;
  }

  .help-grid dd { margin: 0; color: var(--text-dim); }

  .help-note {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 11.5px;
    color: var(--text-faint);
  }
  #heat-warning {
    position: absolute;
    top: 76px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 22;
    padding: 8px 18px;
    border: 1px solid rgba(255, 120, 90, 0.5);
    background: rgba(40, 8, 4, 0.72);
    color: #ffb59f;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }

  #heat-warning.is-on {
    opacity: 1;
    animation: heatPulse 1.4s ease-in-out infinite;
  }

  #heat-warning.is-melting {
    color: #fff1ec;
    border-color: rgba(255, 90, 60, 0.9);
    background: rgba(90, 12, 4, 0.9);
    animation: heatPulse 0.45s ease-in-out infinite;
    font-size: 13px;
  }

  #heat-warning.is-melting::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 50%, transparent 42%, rgba(255, 60, 30, 0.35) 100%);
  }

  @keyframes heatPulse {
    0%, 100% { box-shadow: 0 0 0 rgba(255, 110, 80, 0); }
    50% { box-shadow: 0 0 34px rgba(255, 110, 80, 0.35); }
  }

  /* ── 着陆黑场 ───────────────────────── */
  #fade {
    position: absolute;
    inset: 0;
    z-index: 34;
    background: #02040a;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  #fade.is-black {
    opacity: 1;
  }

  /* ── 星图舞台 ───────────────────────── */
  .map-stage {
    padding: 14px 16px 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  #map-canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #04080d;
  }

  /* ── 全息化：去实心框、去白字 ───────── */
  #boss-bar {
    background:
      linear-gradient(90deg, transparent, rgba(255, 54, 34, 0.13) 10%, rgba(255, 54, 34, 0.06) 90%, transparent),
      repeating-linear-gradient(0deg, rgba(255, 80, 60, 0.05) 0 1px, transparent 1px 3px);
    border: 0;
    border-top: 1px solid rgba(255, 80, 60, 0.26);
    border-bottom: 1px solid rgba(255, 80, 60, 0.16);
    box-shadow: none;
    clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
  }

  #boss-name {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    color: #ff6a52;
    text-shadow: 0 0 14px rgba(255, 60, 40, 0.7);
  }

  #boss-level,
  .boss-meta {
    color: rgba(255, 120, 100, 0.65);
  }

  .boss-track {
    border-color: rgba(255, 80, 60, 0.18);
    background: rgba(255, 80, 60, 0.04);
  }

  #weapon-panel {
    background:
      linear-gradient(180deg, rgba(10, 46, 46, 0.26), rgba(4, 12, 14, 0.08)),
      repeating-linear-gradient(0deg, rgba(89, 224, 200, 0.035) 0 1px, transparent 1px 3px);
    border: 0;
    border-top: 1px solid rgba(89, 224, 200, 0.34);
    border-left: 1px solid rgba(89, 224, 200, 0.12);
    box-shadow: 0 0 18px rgba(89, 224, 200, 0.05);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);
    color: #7ff5e6;
  }

  .weapon-head { color: rgba(89, 224, 200, 0.62); }
  .weapon-head small { color: rgba(143, 232, 216, 0.45); }
  .weapon-row { color: rgba(143, 232, 216, 0.82); }
  .weapon-name { color: #9ff0dc; }
  .weapon-count { color: rgba(143, 232, 216, 0.5); }
  .weapon-key { border-color: rgba(89, 224, 200, 0.18); color: rgba(159, 240, 220, 0.75); }
  .weapon-row.is-on .weapon-key { color: #59e0c8; }
  .weapon-row.is-auto { color: rgba(143, 232, 216, 0.38); }

  #enemy-box {
    background: linear-gradient(180deg, rgba(60, 10, 6, 0.26), rgba(12, 3, 3, 0.08));
    border: 0;
    border-top: 1px solid rgba(255, 80, 60, 0.28);
    border-bottom: 1px solid rgba(255, 80, 60, 0.12);
    box-shadow: 0 0 14px rgba(255, 60, 40, 0.05);
  }

  #fleet-box {
    background:
      linear-gradient(90deg, transparent, rgba(255, 54, 34, 0.1) 12%, rgba(255, 54, 34, 0.04) 88%, transparent),
      repeating-linear-gradient(0deg, rgba(255, 80, 60, 0.04) 0 1px, transparent 1px 3px);
    border: 0;
    border-left: 1px solid rgba(255, 80, 60, 0.28);
    border-right: 1px solid rgba(255, 80, 60, 0.12);
    box-shadow: none;
  }

  #fleet-name {
    color: #ff8a72;
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-shadow: 0 0 10px rgba(255, 70, 50, 0.5);
  }

  .hud-target strong,
  #hud-target {
    color: #9ff0dc;
    text-shadow: 0 0 10px rgba(89, 224, 200, 0.25);
  }

  .hud-target-dist,
  .hud-label {
    color: rgba(143, 232, 216, 0.55);
  }

  .hud-vitals .vital b {
    color: #9ff0dc;
  }

  #hud-mode,
  #hud-fps {
    color: rgba(143, 232, 216, 0.55);
  }

  /* ── 空间站面板也全息化 ─────────────── */
  #panel {
    background: rgba(2, 10, 12, 0.52);
    backdrop-filter: blur(8px);
  }

  .panel-inner {
    border: 0;
    border-top: 1px solid rgba(89, 224, 200, 0.32);
    border-left: 1px solid rgba(89, 224, 200, 0.12);
    background:
      linear-gradient(180deg, rgba(6, 32, 34, 0.72), rgba(3, 10, 12, 0.5)),
      repeating-linear-gradient(0deg, rgba(89, 224, 200, 0.035) 0 1px, transparent 1px 3px);
    box-shadow: 0 0 30px rgba(89, 224, 200, 0.06);
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
    backdrop-filter: blur(10px);
  }

  .panel-head { border-bottom: 1px solid rgba(89, 224, 200, 0.16); }

  .panel-title {
