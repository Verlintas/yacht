<script>
  const map = document.getElementById('map');
  const mapClose = document.getElementById('map-close');
  const helpPanelEl = document.getElementById('help-panel');
  document.getElementById('help-close')?.addEventListener('click', () => helpPanelEl?.classList.remove('is-open'));
  helpPanelEl?.addEventListener('click', (event) => {
    if (event.target === helpPanelEl) helpPanelEl.classList.remove('is-open');
  });

  const panel = document.getElementById('panel');
  mapClose?.addEventListener('click', () => map?.classList.remove('is-open'));
  map?.addEventListener('click', (event) => {
    if (event.target === map) map.classList.remove('is-open');
  });
  panel?.addEventListener('click', (event) => {
    if (event.target === panel) panel.classList.remove('is-open');
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      map?.classList.remove('is-open');
      panel?.classList.remove('is-open');
    }
  });
</script>

