---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import metricsData from '../data/project-metrics.json';
import { berths } from '../data/berths';
import type { ProjectMetrics } from '../lib/project-score';

const projectEntries = await getCollection('projects');
const wikiEntries = await getCollection('wiki');
const metricsByRepo = (metricsData.projects ?? {}) as Record<string, ProjectMetrics>;

const repoOf = (repo?: string): string =>
  (repo ?? '').replace(/^https:\/\/github\.com\//, '').replace(/\/+$/, '');

const projects = projectEntries
  .map((entry) => {
    const metrics = metricsByRepo[repoOf(entry.data.repo)] ?? ({} as ProjectMetrics);
    return {
      id: entry.id,
      title: entry.data.title,
      summary: entry.data.summary ?? '',
      url: `/projects/#${entry.id}`,
      stack: entry.data.stack,
      loc: metrics.loc ?? 0,
      chars: metrics.chars ?? 0,
      tests: metrics.tests ?? 0,
      commits: metrics.commits ?? 0,
      versions: metrics.versions ?? 0,
      createdAt: metrics.createdAt ?? null,
      pushedAt: metrics.pushedAt ?? null,
    };
  })
  .sort((a, b) => b.loc - a.loc);

const systemData = {
  projects,
  counts: {
    projects: projects.length,
    wiki: wikiEntries.length,
    berths: berths.length,
  },
};
---

<Base title="夜航 · Verlintas 的小窝" panic={false}>
  <div class="flight-root">
    <canvas id="flight-canvas"></canvas>

    <div id="boot">
      <div class="boot-inner">
        <p class="boot-eyebrow">VERLINTAS · 私人港口</p>
        <h1 class="boot-title">夜航</h1>
        <p class="boot-sub">第一人称星图</p>
        <div class="boot-track"><div id="boot-bar"></div></div>
        <p class="boot-status" id="boot-status">正在点火</p>
        <p class="boot-hint">W 推进 · 鼠标转向 · Shift 加速 · M 星图 · E 交互</p>
      </div>
    </div>

    <div id="hud">
      <div class="hud-top">
        <div class="hud-brand">
          <span class="hud-brand-mark">V</span>
          <span>夜航</span>
          <a class="hud-classic" href="/port/">经典视图</a>
        </div>
        <div class="hud-target">
          <span class="hud-label">目标</span>
          <strong id="hud-target">未设定</strong>
          <span class="hud-target-dist" id="hud-target-dist">按 M 选择</span>
        </div>
      </div>

      <div class="hud-reticle" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>

      <div id="nav-marker"><span></span></div>

      <div id="hud-prompt"></div>

      <div class="hud-bottom">
        <div class="hud-speed">
          <span class="hud-label">速度</span>
          <div class="hud-speed-value">
            <strong id="hud-speed">0</strong>
            <span>m/s</span>
          </div>
          <div class="hud-bar"><i id="hud-speed-bar"></i></div>
        </div>

        <div class="hud-coords" id="hud-coords">X 0 · Y 0 · Z 0</div>

        <div class="hud-radar">
          <canvas id="radar" width="180" height="180"></canvas>
          <span class="hud-radar-label">9 km</span>
        </div>
      </div>

      <div class="hud-meta">
        <span id="hud-mode">第三人称</span>
        <span class="hud-sep">/</span>
        <span id="hud-fps">-- fps</span>
        <button id="map-toggle" type="button">星图 · M</button>
      </div>
    </div>

    <div id="map">
      <div class="map-inner">
        <header class="map-head">
          <div>
            <p class="map-eyebrow">NAVIGATION</p>
            <h2>星图</h2>
          </div>
          <button class="map-close" id="map-close" type="button" aria-label="关闭">×</button>
        </header>
        <div class="map-list" id="map-list"></div>
      </div>
    </div>

    <div id="panel">
      <div class="panel-inner">
        <header class="panel-head">
          <div>
            <p class="panel-sub" id="panel-sub"></p>
            <h2 class="panel-title" id="panel-title"></h2>
          </div>
          <button class="panel-close" id="panel-close" type="button" aria-label="关闭">×</button>
        </header>
        <div class="panel-body" id="panel-body"></div>
      </div>
    </div>

    <div id="toast"></div>
  </div>

  <script type="application/json" id="system-data" set:html={JSON.stringify(systemData)}></script>

  <script>
    import { buildSystem } from '../game/data';
    import { startGame } from '../game/main';

    const node = document.getElementById('system-data');
    if (node?.textContent) {
      const system = buildSystem(JSON.parse(node.textContent));
      startGame(system).catch((error) => {
        const status = document.getElementById('boot-status');
        if (status) status.textContent = `启动失败：${error instanceof Error ? error.message : String(error)}`;
        console.error(error);
      });
    }
  </script>
</Base>

<style is:global>
  body {
    overflow: hidden;
    background: #03060b;
  }

  .nav,
  footer.foot {
    display: none !important;
  }

  body > .shell {
    padding: 0;
    max-width: none;
  }

  body > .shell > main {
    padding: 0;
  }
</style>

<style is:global>
  .flight-root {
    position: fixed;
    inset: 0;
    background: #03060b;
    overflow: hidden;
  }

  #flight-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── 启动画面 ─────────────────────────────── */
  #boot {
    position: absolute;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 40%, #071018 0%, #03060b 70%);
    transition: opacity 0.8s ease, visibility 0.8s;
  }

  #boot.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .boot-inner {
    width: min(440px, 84vw);
    text-align: center;
  }

  .boot-eyebrow,
  .boot-status,
  .boot-hint,
  .hud-label,
  .hud-coords,
  .hud-meta,
  .map-eyebrow,
  .panel-sub {
    font-family: var(--mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .boot-eyebrow {
    margin: 0 0 18px;
    font-size: 9.5px;
    color: #5b6c78;
  }

  .boot-title {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(64px, 12vw, 104px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #e9eff3;
  }

  .boot-sub {
    margin: 10px 0 34px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #7c8f9c;
  }

  .boot-track {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  #boot-bar {
    display: block;
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #5ec8b8, #c9a55c);
    transition: width 0.35s ease;
  }

  .boot-status {
    margin: 14px 0 0;
    font-size: 9.5px;
    color: #6e8290;
  }

  .boot-hint {
    margin: 26px 0 0;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #46545f;
    text-transform: none;
  }

  /* ── HUD ──────────────────────────────────── */
  #hud {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    color: #e9eff3;
  }

  .hud-top {
    position: absolute;
    top: 22px;
    left: 26px;
    right: 26px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .hud-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9fb0bb;
  }

  .hud-brand-mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(201, 165, 92, 0.5);
    border-radius: 50%;
    color: #c9a55c;
    font-family: var(--serif);
    font-size: 12px;
  }

  .hud-classic {
    margin-left: 8px;
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    color: #6b7c88;
    letter-spacing: 0.1em;
    text-transform: none;
    pointer-events: auto;
  }

  .hud-classic:hover {
    color: #c9a55c;
  }

  .hud-target {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    text-align: right;
  }

  .hud-label {
    font-size: 8.5px;
    color: rgba(160, 180, 195, 0.65);
  }

  #hud-target {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .hud-target-dist {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: #c9a55c;
  }

  .hud-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 46px;
    height: 46px;
    transform: translate(-50%, -50%);
    opacity: 0.55;
  }

  .hud-reticle span {
    position: absolute;
    background: rgba(190, 225, 235, 0.8);
  }

  .hud-reticle span:nth-child(1) {
    left: 50%;
    top: 0;
    width: 1px;
    height: 9px;
  }

  .hud-reticle span:nth-child(2) {
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 9px;
  }

  .hud-reticle span:nth-child(3) {
    top: 50%;
    left: 0;
    height: 1px;
    width: 9px;
  }

  .hud-reticle span:nth-child(4) {
    top: 50%;
    right: 0;
    height: 1px;
    width: 9px;
  }

  #nav-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
    transition: opacity 0.2s;
  }

  #nav-marker.is-on {
    opacity: 1;
  }

  #nav-marker span {
    position: absolute;
    left: -11px;
    top: -11px;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(201, 165, 92, 0.9);
    transform: rotate(45deg);
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.35);
  }

  #hud-prompt {
    position: absolute;
    left: 50%;
    bottom: 24%;
    transform: translateX(-50%) translateY(6px);
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(4, 10, 16, 0.72);
    backdrop-filter: blur(10px);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
    white-space: nowrap;
  }

  #hud-prompt.is-on {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  #hud-prompt b {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    border: 1px solid #c9a55c;
    color: #c9a55c;
    font-size: 10px;
  }

  .hud-bottom {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 24px;
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }

  .hud-speed {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 150px;
  }

  .hud-speed-value {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .hud-speed-value strong {
    font-family: var(--mono);
    font-size: 34px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .hud-speed-value span {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(160, 180, 195, 0.7);
  }

  .hud-bar {
    height: 2px;
    width: 150px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  #hud-speed-bar {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #5ec8b8, #c9a55c);
    transition: width 0.12s linear;
  }

  .hud-coords {
    font-size: 9.5px;
    color: rgba(140, 160, 175, 0.7);
    letter-spacing: 0.1em;
    padding-bottom: 4px;
  }

  .hud-radar {
    position: relative;
    margin-left: auto;
    width: 124px;
    height: 124px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    background: rgba(3, 8, 14, 0.55);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hud-radar canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hud-radar-label {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: rgba(150, 170, 185, 0.6);
  }

  .hud-meta {
    position: absolute;
    right: 26px;
    bottom: 168px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    color: rgba(140, 160, 175, 0.6);
  }

  .hud-sep {
    opacity: 0.4;
  }

  #map-toggle {
    pointer-events: auto;
    margin-left: 6px;
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(4, 10, 16, 0.6);
    color: #cfe0e8;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    cursor: pointer;
  }

  #map-toggle:hover {
    border-color: #c9a55c;
    color: #c9a55c;
  }

  /* ── 星图 ─────────────────────────────────── */
  #map {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: grid;
    place-items: center;
    background: rgba(2, 5, 9, 0.82);
    backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
  }

  #map.is-open {
    opacity: 1;
    visibility: visible;
  }

  .map-inner {
    width: min(620px, 88vw);
    max-height: 76vh;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(6, 12, 18, 0.9);
  }

  .map-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 22px 24px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .map-eyebrow {
    margin: 0 0 6px;
    font-size: 8.5px;
    color: #5b6c78;
  }

  .map-head h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 500;
  }

  .map-close,
  .panel-close {
    width: 30px;
    height: 30px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: #9fb0bb;
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
  }

  .map-close:hover,
  .panel-close:hover {
    border-color: #c9a55c;
    color: #c9a55c;
  }

  .map-list {
    overflow-y: auto;
    padding: 8px 12px 16px;
  }

  .map-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 11px 12px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: transparent;
    color: #dfe8ee;
    text-align: left;
    cursor: pointer;
  }

  .map-row:hover {
    background: rgba(94, 200, 184, 0.08);
  }

  .map-row-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .map-row-title {
    font-size: 14px;
  }

  .map-row-sub {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b7c88;
  }

  .map-row-dist {
    font-family: var(--mono);
    font-size: 11px;
    color: #c9a55c;
  }

  /* ── 面板 ─────────────────────────────────── */
  #panel {
    position: absolute;
    inset: 0;
    z-index: 35;
    display: grid;
    place-items: center;
    background: rgba(2, 5, 9, 0.72);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
  }

  #panel.is-open {
    opacity: 1;
    visibility: visible;
  }

  .panel-inner {
    width: min(760px, 90vw);
    max-height: 82vh;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(6, 12, 18, 0.95);
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 26px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .panel-sub {
    margin: 0 0 6px;
    font-size: 8.5px;
    color: #5b6c78;
  }

  .panel-title {
    margin: 0;
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 500;
  }

  .panel-body {
    padding: 22px 26px 26px;
    overflow-y: auto;
  }

  .panel-desc {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.75;
    color: #b9c8d2;
  }

  .panel-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 12px 22px;
    margin-bottom: 20px;
  }

  .panel-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .panel-stats span {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #64757f;
  }

  .panel-stats b {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 400;
  }

  .panel-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid rgba(201, 165, 92, 0.5);
    color: #c9a55c;
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .panel-action:hover {
    background: rgba(201, 165, 92, 0.12);
  }

  .panel-frame {
    height: min(52vh, 560px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 16px;
    background: #060a10;
  }

  .panel-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .board-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 18px;
    max-height: 42vh;
    overflow-y: auto;
  }

  .board-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .board-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .board-item-title {
    font-size: 13.5px;
    color: #dfe8ee;
  }

  .board-item-meta,
  .board-empty {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: #6b7c88;
  }

  .board-empty {
    margin: 0;
    padding: 12px 0;
  }

  /* ── 提示 ─────────────────────────────────── */
  #toast {
    position: absolute;
    left: 50%;
    bottom: 15%;
    transform: translate(-50%, 8px);
    padding: 9px 18px;
    border: 1px solid rgba(201, 165, 92, 0.35);
    background: rgba(4, 10, 16, 0.85);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: #e9eff3;
    opacity: 0;
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none;
  }

  #toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 760px) {
    .hud-top {
      left: 14px;
      right: 14px;
      top: 14px;
    }

    .hud-bottom {
      left: 14px;
      right: 14px;
      bottom: 14px;
      flex-wrap: wrap;
    }

    .hud-coords {
      display: none;
    }

    .hud-radar {
      width: 96px;
      height: 96px;
    }

    .hud-meta {
      right: 14px;
      bottom: 130px;
    }

    .hud-speed-value strong {
      font-size: 26px;
    }
  }
</style>

<script>
  const map = document.getElementById('map');
  const mapClose = document.getElementById('map-close');
  const panel = document.getElementById('panel');
  mapClose?.addEventListener('click', () => map?.classList.remove('is-open'));
  map?.addEventListener('click', (event) => {
    if (event.target === map) map.classList.remove('is-open');
  });
  panel?.addEventListener('click', (event) => {
    if (event.target === panel) panel.classList.remove('is-open');
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      map?.classList.remove('is-open');
      panel?.classList.remove('is-open');
    }
  });
