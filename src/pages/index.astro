---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import metricsData from '../data/project-metrics.json';
import { berths } from '../data/berths';
import type { ProjectMetrics } from '../lib/project-score';

const projectEntries = await getCollection('projects');
const wikiEntries = await getCollection('wiki');
const metricsByRepo = (metricsData.projects ?? {}) as Record<string, ProjectMetrics>;

const repoOf = (repo?: string): string =>
  (repo ?? '').replace(/^https:\/\/github\.com\//, '').replace(/\/+$/, '');

const projects = projectEntries
  .map((entry) => {
    const metrics = metricsByRepo[repoOf(entry.data.repo)] ?? ({} as ProjectMetrics);
    return {
      id: entry.id,
      title: entry.data.title,
      summary: entry.data.summary ?? '',
      url: `/projects/#${entry.id}`,
      stack: entry.data.stack,
      loc: metrics.loc ?? 0,
      chars: metrics.chars ?? 0,
      tests: metrics.tests ?? 0,
      commits: metrics.commits ?? 0,
      versions: metrics.versions ?? 0,
      createdAt: metrics.createdAt ?? null,
      pushedAt: metrics.pushedAt ?? null,
    };
  })
  .sort((a, b) => b.loc - a.loc);

const systemData = {
  projects,
  counts: {
    projects: projects.length,
    wiki: wikiEntries.length,
    berths: berths.length,
  },
};
---

<Base title="夜航 · Verlintas 的小窝" panic={false}>
  <div class="flight-root">
    <canvas id="flight-canvas"></canvas>

    <div id="boot">
      <div class="boot-inner">
        <p class="boot-eyebrow">VERLINTAS · 私人港口</p>
        <h1 class="boot-title">夜航</h1>
        <p class="boot-sub">第一人称星图</p>
        <div class="boot-track"><div id="boot-bar"></div></div>
        <p class="boot-status" id="boot-status">正在点火</p>
        <p class="boot-hint">W/S 推进·反推 · 鼠标转向 · X 刹车 · Shift 加速 · F 交互 · M 星图</p>
      </div>
    </div>

    <div id="hud">
      <div class="hud-top">
        <div class="hud-brand">
          <span class="hud-brand-mark">V</span>
          <span>夜航</span>
          <a class="hud-classic" href="/port/">经典视图</a>
          <span class="hud-ship" id="hud-ship">A-30</span>
        </div>
        <div class="hud-target">
          <span class="hud-label">目标</span>
          <strong id="hud-target">未设定</strong>
          <span class="hud-target-dist" id="hud-target-dist">按 M 选择</span>
        </div>
      </div>

      <div id="bearing-strip">
        <div class="bearing-axis"></div>
        <div class="bearing-center"></div>
        <div class="bearing-heading" id="bearing-heading">000°</div>
        <div class="bearing-arrow bearing-target" id="bearing-target">◆</div>
        <div class="bearing-arrow bearing-enemy" id="bearing-enemy">▲</div>
      </div>

      <div id="boss-bar">
        <div class="boss-head">
          <span id="boss-name">—</span>
          <small id="boss-level">CAPITAL</small>
        </div>
        <div class="boss-track">
          <i id="boss-shield-fill"></i>
          <i id="boss-hull-fill"></i>
        </div>
        <div class="boss-meta">
          <span id="boss-hp-text">—</span>
          <span id="boss-dist">—</span>
        </div>
      </div>

      <div id="hit-alert">⚠ 遭受攻击</div>
      <div id="impact-flash"></div>

      <div id="cockpit" aria-hidden="true">
        <div class="cockpit-canopy"></div>
        <div class="cockpit-hud">
          <div class="cockpit-tile">
            <span>速度</span>
            <strong id="cockpit-speed">0</strong>
            <em>m/s</em>
          </div>
          <div class="cockpit-tile cockpit-tile-right">
            <span>目标</span>
            <strong id="cockpit-target">—</strong>
            <em id="cockpit-dist">—</em>
          </div>
        </div>
        <div class="cockpit-ladder" id="cockpit-ladder">
          <i data-deg="-30" style="--deg:-30"><b>-30</b></i>
          <i data-deg="-20" style="--deg:-20"><b>-20</b></i>
          <i data-deg="-10" style="--deg:-10"><b>-10</b></i>
          <i data-deg="0" style="--deg:0"><b>0</b></i>
          <i data-deg="10" style="--deg:10"><b>10</b></i>
          <i data-deg="20" style="--deg:20"><b>20</b></i>
          <i data-deg="30" style="--deg:30"><b>30</b></i>
        </div>
        <div class="cockpit-crosshair">
          <span class="ch-wing"></span>
        </div>
        <div class="cockpit-tape cockpit-tape-left">
          <b id="tape-speed">0</b>
          <span>m/s</span>
        </div>
        <div class="cockpit-dash">
          <div class="dash-panel">
            <span class="dash-label">HULL</span>
            <i id="dash-hull"></i>
          </div>
          <div class="dash-panel">
            <span class="dash-label">SHLD</span>
            <i id="dash-shield"></i>
          </div>
          <div class="dash-panel dash-panel-wide">
            <span class="dash-label">THR</span>
            <i id="dash-throttle"></i>
          </div>
        </div>
        <div class="cockpit-visor"></div>
      </div>

      <div class="hud-reticle" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>

      <div id="nav-marker"><span></span></div>

      <div id="hud-prompt"></div>

      <div id="boost-ui">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle class="boost-outer" cx="60" cy="60" r="56" />
          <circle class="boost-ticks" cx="60" cy="60" r="52" />
          <circle class="boost-track" cx="60" cy="60" r="46" />
          <circle class="boost-fill" id="boost-ring" cx="60" cy="60" r="46" />
        </svg>
        <div class="boost-text">
          <small id="boost-key">B</small>
          <b id="boost-label">待机</b>
          <span id="boost-sub">跃迁充能</span>
        </div>
      </div>

      <div id="warp-overlay"></div>

      <div id="help-hint">
        <kbd>F1</kbd> 操作说明
      </div>

      <div id="help-panel">
        <div class="help-inner">
          <header class="help-head">
            <h2>操作</h2>
            <button type="button" id="help-close" aria-label="关闭">×</button>
          </header>
          <div class="help-grid">
            <section>
              <h3>飞行</h3>
              <dl>
                <dt>鼠标</dt><dd>转向；自由视角时环绕相机</dd>
                <dt>W / S</dt><dd>前进 / 反推</dd>
                <dt>A / D</dt><dd>左右侧移</dd>
                <dt>R / C</dt><dd>上升 / 下降</dd>
                <dt>Q / E</dt><dd>滚转（不会自动回正）</dd>
                <dt>B</dt><dd>按住充能；大型舰为 G+H+B，充满后跃迁</dd>
                <dt>Shift</dt><dd>次级加速（弱于 B 充能）</dd>
                <dt>X / Space</dt><dd>刹车</dd>
                <dt>Z</dt><dd>飞行辅助开关</dd>
              </dl>
            </section>
            <section>
              <h3>战斗与交互</h3>
              <dl>
                <dt>鼠标左键</dt><dd>按住持续开火</dd>
                <dt>1–9 / 0</dt><dd>切换武器组 / 全部武器</dd>
                <dt>F</dt><dd>停靠 / 进入 / 关闭面板</dd>
                <dt>M</dt><dd>雷达与目标</dd>
                <dt>V</dt><dd>第一 / 第三 / 自由视角（鼠标环绕、滚轮缩放）</dd>
                <dt>Esc</dt><dd>关闭面板</dd>
                <dt>F1</dt><dd>打开 / 关闭本说明</dd>
              </dl>
            </section>
          </div>
          <p class="help-note">
            自动炮（Auto）只攻击已经向我方开火的目标，并带弹道预测。鱼雷会追踪准星附近的飞船。每门武器独立冷却。空间站可以免费换船。
          </p>
        </div>
      </div>

      <div class="hud-vitals">
        <div class="vital" id="hull-vital">
          <span>结构</span>
          <div class="vital-bar"><i class="vital-ghost" id="hull-ghost"></i><i id="hull-fill"></i></div>
          <b id="hull-text">—</b>
        </div>
        <div class="vital" id="shield-vital">
          <span>护盾</span>
          <div class="vital-bar vital-shield"><i class="vital-ghost" id="shield-ghost"></i><i id="shield-fill"></i></div>
          <b id="shield-text">—</b>
        </div>
      </div>

      <div id="enemy-box">
        <span id="enemy-count"></span>
        <div class="enemy-bar"><i id="enemy-hp"></i></div>
        <span id="enemy-dist"></span>
      </div>

      <div id="fleet-box">
        <div class="fleet-head">
          <span>敌方舰队</span>
          <b id="fleet-status">主力</b>
        </div>
        <div class="fleet-name" id="fleet-name">—</div>
        <div class="fleet-meta">
          <span id="fleet-count">护卫 0</span>
          <span id="fleet-comp"></span>
          <span id="fleet-dist">—</span>
        </div>
      </div>

      <div id="weapon-panel">
        <div class="weapon-head">
          <span>武器</span>
          <small>1–9 切换 · 0 全部 · 按住左键</small>
        </div>
        <div id="weapon-list"></div>
      </div>

      <div class="hud-bottom">
        <div class="hud-speed">
          <span class="hud-label">速度</span>
          <div class="hud-speed-value">
            <strong id="hud-speed">0</strong>
            <span>m/s</span>
          </div>
          <div class="hud-bar"><i id="hud-speed-bar"></i></div>
          <div class="hud-throttle">
            <span class="hud-label">推力</span>
            <div class="hud-bar"><i id="hud-throttle-bar"></i></div>
            <span class="hud-assist" id="hud-assist">辅助 开</span>
          </div>
        </div>

        <div class="hud-coords" id="hud-coords">X 0 · Y 0 · Z 0</div>

        <div class="hud-radar">
          <canvas id="radar" width="180" height="180"></canvas>
          <span class="hud-radar-label">9 km</span>
        </div>
      </div>

      <div class="hud-meta">
        <span id="hud-mode">第三人称</span>
        <span class="hud-sep">/</span>
        <span id="hud-fps">-- fps</span>
        <button id="map-toggle" type="button">星图 · M</button>
      </div>
    </div>

    <div id="map">
      <div class="map-inner">
        <header class="map-head">
          <div>
            <p class="map-eyebrow">NAVIGATION</p>
            <h2>星图</h2>
          </div>
          <button class="map-close" id="map-close" type="button" aria-label="关闭">×</button>
        </header>
        <div class="map-stage">
          <canvas id="map-canvas" width="560" height="320"></canvas>
        </div>
        <div class="map-list" id="map-list"></div>
      </div>
    </div>

    <div id="panel">
      <div class="panel-inner">
        <header class="panel-head">
          <div>
            <p class="panel-sub" id="panel-sub"></p>
            <h2 class="panel-title" id="panel-title"></h2>
          </div>
          <button class="panel-close" id="panel-close" type="button" aria-label="关闭">×</button>
        </header>
        <div class="panel-body" id="panel-body"></div>
      </div>
    </div>

    <div id="heat-warning">⚠ 恒星辐射区 · 自动脱离</div>
    <div id="fade"></div>
    <div id="toast"></div>
  </div>

  <script type="application/json" id="system-data" set:html={JSON.stringify(systemData)}></script>

  <script>
    import { buildSystem } from '../game/data';
    import { startGame } from '../game/main';

    const node = document.getElementById('system-data');
    if (node?.textContent) {
      const system = buildSystem(JSON.parse(node.textContent));
      startGame(system).catch((error) => {
        const status = document.getElementById('boot-status');
        if (status) status.textContent = `启动失败：${error instanceof Error ? error.message : String(error)}`;
        console.error(error);
      });
    }
  </script>
</Base>

<style is:global>
  body {
    overflow: hidden;
    background: #03060b;
  }

  .nav,
  footer.foot {
    display: none !important;
  }

  body > .shell {
    padding: 0;
    max-width: none;
  }

  body > .shell > main {
    padding: 0;
  }
</style>

<style is:global>
  .flight-root {
    position: fixed;
    inset: 0;
    background: #03060b;
    overflow: hidden;
  }

  #flight-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── 启动画面 ─────────────────────────────── */
  #boot {
    position: absolute;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 40%, #071018 0%, #03060b 70%);
    transition: opacity 0.8s ease, visibility 0.8s;
  }

  #boot.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .boot-inner {
    width: min(440px, 84vw);
    text-align: center;
  }

  .boot-eyebrow,
  .boot-status,
  .boot-hint,
  .hud-label,
  .hud-coords,
  .hud-meta,
  .map-eyebrow,
  .panel-sub {
    font-family: var(--mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .boot-eyebrow {
    margin: 0 0 18px;
    font-size: 9.5px;
    color: #5b6c78;
  }

  .boot-title {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(64px, 12vw, 104px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #e9eff3;
  }

  .boot-sub {
    margin: 10px 0 34px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #7c8f9c;
  }

  .boot-track {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  #boot-bar {
    display: block;
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #5ec8b8, #c9a55c);
    transition: width 0.35s ease;
  }

  .boot-status {
    margin: 14px 0 0;
    font-size: 9.5px;
    color: #6e8290;
  }

  .boot-hint {
    margin: 26px 0 0;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #46545f;
    text-transform: none;
  }

  /* ── HUD ──────────────────────────────────── */
  #hud {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    color: #e9eff3;
  }

  .hud-top {
    position: absolute;
    top: 22px;
    left: 26px;
    right: 26px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .hud-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9fb0bb;
  }

  .hud-brand-mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(201, 165, 92, 0.5);
    border-radius: 50%;
    color: #c9a55c;
    font-family: var(--serif);
    font-size: 12px;
  }

  .hud-classic {
    margin-left: 8px;
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    color: #6b7c88;
    letter-spacing: 0.1em;
    text-transform: none;
    pointer-events: auto;
  }

  .hud-classic:hover {
    color: #c9a55c;
  }

  .hud-target {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    text-align: right;
  }

  .hud-label {
    font-size: 8.5px;
    color: rgba(160, 180, 195, 0.65);
  }

  #hud-target {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .hud-target-dist {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: #c9a55c;
  }

  .hud-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 46px;
    height: 46px;
    transform: translate(-50%, -50%);
    opacity: 0.55;
  }

  .hud-reticle span {
    position: absolute;
    background: rgba(190, 225, 235, 0.8);
  }

  .hud-reticle span:nth-child(1) {
    left: 50%;
    top: 0;
    width: 1px;
    height: 9px;
  }

  .hud-reticle span:nth-child(2) {
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 9px;
  }

  .hud-reticle span:nth-child(3) {
    top: 50%;
    left: 0;
    height: 1px;
    width: 9px;
  }

  .hud-reticle span:nth-child(4) {
    top: 50%;
    right: 0;
    height: 1px;
    width: 9px;
  }

  #nav-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
    transition: opacity 0.2s;
  }

  #nav-marker.is-on {
    opacity: 1;
  }

  #nav-marker span {
    position: absolute;
    left: -11px;
    top: -11px;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(201, 165, 92, 0.9);
    transform: rotate(45deg);
    box-shadow: 0 0 18px rgba(201, 165, 92, 0.35);
  }

  #hud-prompt {
    position: absolute;
    left: 50%;
    bottom: 24%;
    transform: translateX(-50%) translateY(6px);
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(4, 10, 16, 0.72);
    backdrop-filter: blur(10px);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
    white-space: nowrap;
  }

  #hud-prompt.is-on {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  #hud-prompt b {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    border: 1px solid #c9a55c;
    color: #c9a55c;
    font-size: 10px;
  }

  .hud-bottom {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 24px;
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }

  .hud-speed {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 150px;
  }

  .hud-speed-value {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .hud-speed-value strong {
    font-family: var(--mono);
    font-size: 34px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .hud-speed-value span {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(160, 180, 195, 0.7);
  }

  .hud-bar {
    height: 2px;
    width: 150px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  #hud-speed-bar {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #5ec8b8, #c9a55c);
    transition: width 0.12s linear;
  }

  .hud-coords {
    font-size: 9.5px;
    color: rgba(140, 160, 175, 0.7);
    letter-spacing: 0.1em;
    padding-bottom: 4px;
  }

  .hud-radar {
    position: relative;
    margin-left: auto;
    width: 124px;
    height: 124px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    background: rgba(3, 8, 14, 0.55);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hud-radar canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hud-radar-label {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: rgba(150, 170, 185, 0.6);
  }

  .hud-meta {
    position: absolute;
    right: 26px;
    bottom: 168px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    color: rgba(140, 160, 175, 0.6);
  }

  .hud-sep {
    opacity: 0.4;
  }

  #map-toggle {
    pointer-events: auto;
    margin-left: 6px;
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(4, 10, 16, 0.6);
    color: #cfe0e8;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    cursor: pointer;
  }

  #map-toggle:hover {
    border-color: #c9a55c;
    color: #c9a55c;
  }

  /* ── 星图 ─────────────────────────────────── */
  #map {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: grid;
    place-items: center;
    background: rgba(2, 5, 9, 0.82);
    backdrop-filter: blur(10px);
