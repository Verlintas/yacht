---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formatDate = (date: Date): string =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
---

<Base title={`${note.data.title} · Verlintas 的小窝`} description={note.data.summary}>
  <p class="eyebrow">
    <a href={url('notes/')}>← 航海日志</a>
  </p>
  <h1 class="page-title">{note.data.title}</h1>
  <p class="page-sub">
    {formatDate(note.data.date)}
    {note.data.tags.length > 0 && ` · ${note.data.tags.join(' / ')}`}
  </p>

  <article class="panel panel-pad prose spaced">
    <Content />
  </article>
</Base>
