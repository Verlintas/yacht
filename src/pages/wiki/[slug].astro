---
import WikiLayout from '../../layouts/WikiLayout.astro';
import WikiStatus from '../../components/WikiStatus.astro';
import WikiRefs from '../../components/WikiRefs.astro';
import WikiAiNotice from '../../components/WikiAiNotice.astro';
import WikiNature from '../../components/WikiNature.astro';
import WikiNatureNotice from '../../components/WikiNatureNotice.astro';
import WikiToc from '../../components/WikiToc.astro';
import { getCollection, render } from 'astro:content';
import { getCategory, getScenario } from '../../data/wiki';
import { url } from '../../lib/url';
import { countChars, formatDate, staleness, stripMarkdown } from '../../lib/wiki-text';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map((entry) => {
    const siblings = entries
      .filter((item) => item.data.category === entry.data.category)
      .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
    const position = siblings.findIndex((item) => item.id === entry.id);

    const scored = entries
      .filter((item) => item.id !== entry.id)
      .map((item) => {
        const sharedTags = item.data.tags.filter((tag) => entry.data.tags.includes(tag)).length;
        const sharedScenarios = item.data.scenarios.filter((scenario) =>
          entry.data.scenarios.includes(scenario),
        ).length;
        const sameCategory = item.data.category === entry.data.category ? 1 : 0;
        return { item, score: sharedTags * 3 + sharedScenarios * 2 + sameCategory };
      })
      .filter((row) => row.score > 0)
      .sort((a, b) => b.score - a.score || a.item.data.order - b.item.data.order)
      .slice(0, 4);

    return {
      params: { slug: entry.id },
      props: {
        entry,
        siblings,
        prev: position > 0 ? siblings[position - 1] : null,
        next: position >= 0 && position < siblings.length - 1 ? siblings[position + 1] : null,
        related: scored.map((row) => row.item),
      },
    };
  });
}

const { entry, siblings, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);
const category = getCategory(entry.data.category);
const scenarios = entry.data.scenarios.map((slug) => getScenario(slug));
const others = siblings.filter((item) => item.id !== entry.id);
const chars = countChars(stripMarkdown(entry.body ?? ''));
const age = staleness(entry.data.updated);
const minutes = Math.max(1, Math.round(chars / 400));
---

<WikiLayout
  title={`${entry.data.title} · 百科 · Verlintas 的小窝`}
  description={entry.data.summary}
>
  <div class="read-progress" id="readProgress" aria-hidden="true"></div>

  <p class="eyebrow">
    <a href={url('wiki/')}>← 百科</a>
    <span> / {category.label}</span>
  </p>
  <h1 class="page-title">{entry.data.title}</h1>
  <p class="page-sub meta-row">
    <WikiStatus status={entry.data.status} />
    <WikiNature nature={entry.data.nature} />
    <WikiAiNotice variant="compact" />
    <span class="readout-note">
      {chars.toLocaleString('zh-CN')} 字 · 约 {minutes} 分钟
    </span>
    <button class="icon-btn read-toggle" type="button" id="readToggle" aria-pressed="false">
      标记已读
    </button>
  </p>

  {
    entry.data.tags.length > 0 && (
      <p class="tag-row tag-row-wrap">
        {entry.data.tags.map((tag) => (
          <a class="tag tag-sm tag-link" href={url(`wiki/tag/${encodeURIComponent(tag)}/`)}>
            {tag}
          </a>
        ))}
      </p>
    )
  }

  {
    age.level !== 'fresh' && (
      <div class:list={['panel', 'panel-pad', 'notice', age.level === 'stale' ? 'notice-warn' : 'notice-info', 'spaced']}>
        <strong>时效提醒</strong>
        <p>
          本页最后核对于 {formatDate(entry.data.updated)}，距今 {age.days} 天（{age.label}）。
          <b>上游资料可能已经变化</b>，请对照文末来源原文确认。
        </p>
      </div>
    )
  }

  {
    scenarios.length > 0 && (
      <p class="scenario-row scenario-row-sm">
        <span class="readout-note">属于：</span>
        {scenarios.map((scenario) => (
          <a class="scenario-chip scenario-chip-sm" href={url(`wiki/path/${scenario.slug}/`)}>
            {scenario.title}
          </a>
        ))}
      </p>
    )
  }

  <WikiToc headings={headings} />

  <article class="panel panel-pad prose spaced" data-entry-id={entry.id}>
    <WikiNatureNotice nature={entry.data.nature} />
    <Content />
  </article>

  <WikiRefs entry={entry} />

  <nav class="pager spaced" aria-label="同分类上下条">
    <span class="pager-side">
      {
        prev && (
          <a class="pager-link" href={url(`wiki/${prev.id}/`)}>
            <span class="readout-label">上一条</span>
            <strong>{prev.data.title}</strong>
          </a>
        )
      }
    </span>
    <span class="pager-side pager-side-end">
      {
        next && (
          <a class="pager-link" href={url(`wiki/${next.id}/`)}>
            <span class="readout-label">下一条</span>
            <strong>{next.data.title}</strong>
          </a>
        )
      }
    </span>
  </nav>

  {
    related.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2 class="section-title">相关条目</h2>
          <span class="section-note">按标签与场景匹配</span>
        </div>
        <div class="grid">
          {related.map((item) => (
            <a class="panel panel-pad note-card" href={url(`wiki/${item.id}/`)}>
              <span class="card-head">
                <span class="readout-label">{getCategory(item.data.category).label}</span>
                <WikiStatus status={item.data.status} size="sm" />
              </span>
              <strong class="note-title">{item.data.title}</strong>
              {item.data.summary && <span class="readout-note">{item.data.summary}</span>}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2 class="section-title">同类条目</h2>
          <span class="section-note">{category.label}</span>
        </div>
        <div class="grid">
          {others.map((item) => (
            <a class="panel panel-pad note-card" href={url(`wiki/${item.id}/`)}>
              <span class="card-head">
                <WikiStatus status={item.data.status} size="sm" />
              </span>
              <strong class="note-title">{item.data.title}</strong>
              {item.data.summary && <span class="readout-note">{item.data.summary}</span>}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <script>
    const entryId = document.querySelector<HTMLElement>('[data-entry-id]')?.dataset.entryId ?? '';
    const progress = document.getElementById('readProgress');
    const toggle = document.getElementById('readToggle');
    const STORE = 'yacht:wiki:read';

    const readSet = (): Set<string> => {
      try {
        return new Set<string>(JSON.parse(localStorage.getItem(STORE) ?? '[]'));
      } catch {
        return new Set<string>();
      }
    };

    const save = (set: Set<string>): void => {
      try {
        localStorage.setItem(STORE, JSON.stringify(Array.from(set)));
      } catch {
        /* 忽略 */
      }
    };

    let read = readSet();
    const syncToggle = (): void => {
      if (!toggle) return;
      const isRead = read.has(entryId);
      toggle.setAttribute('aria-pressed', String(isRead));
      toggle.textContent = isRead ? '已读' : '标记已读';
    };
    syncToggle();

    toggle?.addEventListener('click', () => {
      if (read.has(entryId)) read.delete(entryId);
      else read.add(entryId);
      save(read);
      syncToggle();
    });

    let marked = read.has(entryId);
    const onScroll = (): void => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
      if (progress) progress.style.transform = `scaleX(${ratio})`;
      if (!marked && ratio > 0.85) {
        marked = true;
        read.add(entryId);
        save(read);
        syncToggle();
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  </script>
</WikiLayout>
