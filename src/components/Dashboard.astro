---
interface Props {
  coastal: boolean;
}
const { coastal } = Astro.props;
---

<div data-dashboard>
  <section class="panel hero-panel">
    <div class="readout">
      <span class="readout-label" data-slot="berth-kind">泊位</span>
      <span class="hero-clock" data-slot="clock">--:--<span>:--</span></span>
      <span class="hero-meta" data-slot="date">读取中</span>
    </div>
    <div class="hero-meta hero-side">
      <strong data-slot="berth-name">读取中</strong>
      <span class="hero-latin" data-slot="berth-latin"></span>
      <span class="readout-note" data-slot="updated"></span>
    </div>
  </section>

  <div class="grid grid-wide spaced">
    <section class="panel panel-pad">
      <div class="card-head">
        <span class="readout-label">天气实况</span>
        <span class="readout-note" data-slot="weather-desc">读取中</span>
      </div>
      <div class="weather-head">
        <span data-slot="weather-icon" aria-hidden="true"></span>
        <span class="readout-value readout-hero" data-slot="weather-temp">--</span>
        <span class="readout hero-side">
          <span class="readout-label">今日高低温</span>
          <span class="readout-value readout-small" data-slot="weather-range">--</span>
        </span>
      </div>
      <dl class="stat-list spaced">
        <div>
          <dt>体感 / 湿度</dt>
          <dd>
            <span data-slot="weather-apparent">--</span> · <span data-slot="weather-humidity">--</span>
          </dd>
        </div>
        <div>
          <dt>露点</dt>
          <dd data-slot="weather-dewpoint">--</dd>
        </div>
      </dl>
      <div class="berth-block spaced">
        <div class="card-head">
          <span class="readout-label">未来 24 小时</span>
          <span class="readout-note">
            <span data-slot="hourly-min">--</span> ~ <span data-slot="hourly-max">--</span>
          </span>
        </div>
        <div class="spark-wrap" data-slot="hourly-chart"></div>
      </div>
    </section>

    <section class="panel panel-pad">
      <div class="card-head">
        <span class="readout-label">风与降水</span>
      </div>
      <dl class="stat-list">
        <div>
          <dt>风速</dt>
          <dd data-slot="weather-wind">--</dd>
        </div>
        <div>
          <dt>阵风</dt>
          <dd data-slot="weather-gusts">--</dd>
        </div>
        <div>
          <dt>风向</dt>
          <dd>
            <span class="wind-cell">
              <span data-slot="weather-windarrow"></span>
              <span data-slot="weather-winddir">--</span>
            </span>
          </dd>
        </div>
        <div>
          <dt>降水</dt>
          <dd data-slot="weather-precip">--</dd>
        </div>
        <div>
          <dt>降水概率</dt>
          <dd data-slot="weather-prob">--</dd>
        </div>
      </dl>
    </section>

    <section class="panel panel-pad">
      <div class="card-head">
        <span class="readout-label">大气与日照</span>
      </div>
      <dl class="stat-list">
        <div>
          <dt>气压</dt>
          <dd data-slot="weather-pressure">--</dd>
        </div>
        <div>
          <dt>能见度</dt>
          <dd data-slot="weather-visibility">--</dd>
        </div>
        <div>
          <dt>云量</dt>
          <dd data-slot="weather-cloud">--</dd>
        </div>
        <div>
          <dt>紫外线</dt>
          <dd>
            <span data-slot="weather-uv">--</span>
            <span class="badge badge-sm" data-slot="weather-uv-badge">--</span>
          </dd>
        </div>
        <div>
          <dt>日出 / 日落</dt>
          <dd>
            <span data-slot="sun-sunrise">--</span> · <span data-slot="sun-sunset">--</span>
          </dd>
        </div>
        <div>
          <dt>白昼长度</dt>
          <dd data-slot="sun-daylight">--</dd>
        </div>
      </dl>
    </section>

    <section class="panel panel-pad" data-card="air">
      <div class="card-head">
        <span class="readout-label">空气质量</span>
        <span class="badge" data-slot="air-badge">--</span>
      </div>
      <dl class="stat-list">
        <div>
          <dt>AQI（美标）</dt>
          <dd data-slot="air-aqi">--</dd>
        </div>
        <div>
          <dt>PM2.5 / PM10</dt>
          <dd>
            <span data-slot="air-pm25">--</span> · <span data-slot="air-pm10">--</span>
          </dd>
        </div>
        <div>
          <dt>NO₂ / O₃</dt>
          <dd>
            <span data-slot="air-no2">--</span> · <span data-slot="air-o3">--</span>
          </dd>
        </div>
        <div>
          <dt>SO₂ / CO</dt>
          <dd>
            <span data-slot="air-so2">--</span> · <span data-slot="air-co">--</span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="panel panel-pad" data-card="sea" hidden={!coastal}>
      <div class="card-head">
        <span class="readout-label">海况</span>
        <span class="readout-note">近岸</span>
      </div>
      <dl class="stat-list">
        <div>
          <dt>浪高 / 浪向</dt>
          <dd>
            <span data-slot="sea-wave">--</span> · <span data-slot="sea-wavedir">--</span>
          </dd>
        </div>
        <div>
          <dt>浪周期</dt>
          <dd data-slot="sea-period">--</dd>
        </div>
        <div>
          <dt>涌浪 / 方向</dt>
          <dd>
            <span data-slot="sea-swell">--</span> · <span data-slot="sea-swelldir">--</span>
          </dd>
        </div>
        <div>
          <dt>海表温度</dt>
          <dd data-slot="sea-sst">--</dd>
        </div>
        <div>
          <dt>表层流</dt>
          <dd data-slot="sea-current">--</dd>
        </div>
      </dl>
    </section>

    <section class="panel panel-pad">
      <div class="card-head">
        <span class="readout-label">未来几天</span>
        <span class="readout-note">最高 / 最低 · 降水概率 · 风</span>
      </div>
      <div class="forecast" data-slot="forecast"></div>
    </section>
  </div>

  <div class="panel panel-pad panel-error spaced" data-slot="error" hidden></div>
</div>
