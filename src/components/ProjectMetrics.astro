---
import type { ProjectMetrics } from '../lib/project-score';

interface Props {
  metrics?: ProjectMetrics;
}

const { metrics } = Astro.props;

const format = (value: number | null | undefined): string =>
  typeof value === 'number' && Number.isFinite(value) ? value.toLocaleString('zh-CN') : '—';

const hasAny =
  metrics &&
  [metrics.loc, metrics.chars, metrics.commits, metrics.tests, metrics.versions].some(
    (value) => typeof value === 'number',
  );
---

{
  hasAny && (
    <dl class="proj-metrics" aria-label="工程指标">
      <div>
        <dt>代码行</dt>
        <dd>{format(metrics?.loc)}</dd>
      </div>
      <div>
        <dt>字符</dt>
        <dd>{format(metrics?.chars)}</dd>
      </div>
      <div>
        <dt>提交</dt>
        <dd>{format(metrics?.commits)}</dd>
      </div>
      <div>
        <dt>测试用例</dt>
        <dd>{format(metrics?.tests)}</dd>
      </div>
      <div>
        <dt>版本</dt>
        <dd>{format(metrics?.versions)}</dd>
      </div>
      {metrics?.measuredAt && <span class="proj-metrics-note">采集于 {metrics.measuredAt}</span>}
    </dl>
  )
}

<style>
  .proj-metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 2px 0 0;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .proj-metrics > div {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }

  .proj-metrics dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .proj-metrics dd {
    margin: 0;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 12.5px;
    color: var(--text);
  }

  .proj-metrics-note {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
  }
</style>
